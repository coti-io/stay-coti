{
  "name": "@coti-community/backend",
  "version": "0.0.1",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "rimraf ./dist && tsc --build",
    "dev": "nodemon",
    "start": "yarn typeorm:migration && node -r dotenv/config dist/src/main.js",
    "typeorm:migration": "npx typeorm migration:run -d dist/src/datasource.js",
    "clean": "rimraf ./dist",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "COTI Community Backend API",
  "resolutions": {
    "validator": "^13.15.22"
  },
  "dependencies": {
    "@blazjs/cache": "^0.0.1-alpha.2",
    "@blazjs/common": "0.0.1-alpha.2",
    "@blazjs/datasource": "^0.0.1-alpha.2",
    "axios": "^1.8.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "rimraf": "^6.0.1",
    "typedi": "^0.10.0",
    "typeorm": "^0.3.20",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "nodemon": "^3.1.0",
    "prettier": "^3.8.0",
    "ts-node": "^10.9.2"
  }
}
